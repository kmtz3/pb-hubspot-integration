# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Productboard ─────────────────────────────────────────────────────────────
PB_API_KEY=your_pb_api_key_here

# ─── HubSpot (service key token) ─────────────────────────────────────────────
# Required scopes (all three):
#   - crm.objects.companies.read   read company records
#   - crm.schemas.companies.read   read company property metadata
#   - crm.objects.owners.read      resolve owner IDs to emails for PB member fields
# The Connect tab probes all three on save and on every Test connection run.
HUBSPOT_API_KEY=your_hubspot_service_key_token_here

# ─── Firestore (local dev / emulator) ────────────────────────────────────────
# Set both vars to route firebase-admin to the local emulator (no GCP project needed).
# Remove / leave blank in production — Cloud Run ADC handles auth automatically.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIRESTORE_PROJECT_ID=demo-local

# ─── GCP (production only) ────────────────────────────────────────────────────
# Required in production for Cloud Scheduler API calls (schedule management).
# Leave blank in local dev.
GCP_PROJECT_ID=
GCP_REGION=us-central1
# Cloud Scheduler job name — set after first Terraform deploy (terraform output scheduler_job_name)
GCS_JOB_NAME=pb-hubspot-sync-scheduler

# ─── Google OAuth (Settings page authentication) ─────────────────────────────
# Create an OAuth 2.0 Web Client ID at GCP Console → APIs & Services → Credentials.
# Authorised redirect URI: https://YOUR-CLOUD-RUN-URL/auth/google/callback
#   + http://localhost:3000/auth/google/callback for local dev.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
# Restrict sign-in to this Google Workspace domain (e.g. productboard.com).
GOOGLE_ALLOWED_DOMAIN=yourdomain.com
# Optional: comma-separated list of specific emails allowed to access Settings.
# Leave blank to permit any @GOOGLE_ALLOWED_DOMAIN Workspace account.
GOOGLE_ALLOWED_EMAILS=
# Session signing secret — generate with: openssl rand -base64 32
# Store in Secret Manager in production.
SESSION_SECRET=
# Full public URL of this service — used to build the OAuth callback URL and as the
# expected audience when verifying Cloud Scheduler OIDC tokens on /api/sync/run.
# Local dev: use the Vite port (5173) so the post-auth redirect stays on the HMR server.
# Production: set to your Cloud Run URL (e.g. https://pb-hubspot-sync-abc123-uc.a.run.app).
APP_URL=http://localhost:5173

# Service account email of the Cloud Scheduler invoker. Used to authorise scheduler
# calls to /api/sync/run via verified OIDC tokens. Required in production.
# Local dev: leave blank — the scheduler does not run locally.
SCHEDULER_SA_EMAIL=
# Expected audience claim on Cloud Scheduler OIDC tokens. Must match the audience
# Terraform configured on the scheduler job (typically the Cloud Run service URI).
# Defaults to APP_URL when unset; set explicitly when APP_URL is a custom domain.
SCHEDULER_OIDC_AUDIENCE=

# ─── Sync behaviour ───────────────────────────────────────────────────────────
# Number of companies processed in parallel (1–25). Default 5.
SYNC_CONCURRENCY=5
# Set to true to log intended writes without calling any API. Always true in unit tests.
DRY_RUN=false
LOG_LEVEL=info
