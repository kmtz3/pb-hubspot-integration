{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": "dist/client",
    "rootDir": "src",
    "types": ["vite/client"]
  },
  "include": [
    "src/client/**/*",
    "src/types/**/*",
    "src/sync/mapper.ts"
  ],
  "exclude": ["src/server/**/*", "src/lib/**/*", "src/routes/**/*"]
}
