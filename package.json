{
  "name": "pb-hubspot-integration",
  "version": "1.0.2",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:client": "vite",
    "dev:emulator": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:start --only firestore --project demo-local --import .firebase-data --export-on-exit .firebase-data",
    "emulator:export": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:export .firebase-data --project demo-local --force",
    "dev": "concurrently --kill-others-on-fail \"npm run dev:emulator\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server/server.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint 'src/**/*.ts' 'src/**/*.tsx'",
    "test": "DRY_RUN=true jest --selectProjects unit",
    "test:firestore": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIRESTORE_PROJECT_ID=demo-local jest --selectProjects firestore",
    "test:integration": "jest --selectProjects integration",
    "test:all": "npm test && npm run test:firestore && TEST_INTEGRATION=true npm run test:integration"
  },
  "dependencies": {
    "@google-cloud/scheduler": "^4.0.0",
    "@google-cloud/secret-manager": "^5.0.0",
    "@types/sanitize-html": "^2.16.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-session": "^1.18.0",
    "firebase-admin": "^12.0.0",
    "google-auth-library": "^9.15.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "react-router-dom": "^7.14.2",
    "sanitize-html": "^2.17.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "jest": "^29.5.0",
    "lucide-react": "^0.263.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-hook-form": "^7.45.0",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
