project_id            = "your-gcp-project-id"
region                = "europe-west1"
service_name          = "pb-hubspot-sync"
# `image` is optional — defaults to Google's hello-world placeholder.
# Cloud Build CD takes over the image attribute on first push to main.
# Override only if you need a different bootstrap image.
# image               = "us-docker.pkg.dev/cloudrun/container/hello"
app_url               = "https://pb-hubspot-sync-PROJECT_NUMBER.europe-west1.run.app"
google_allowed_domain = "yourdomain.com"
google_allowed_emails = ""     # optional: "admin@yourdomain.com,ops@yourdomain.com"
sync_concurrency      = 5
scheduler_schedule    = "0 2 * * *"   # daily at 02:00 UTC
scheduler_timezone    = "UTC"
history_retention_days = 90
